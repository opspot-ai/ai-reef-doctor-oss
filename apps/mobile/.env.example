# AI Reef Doctor — mobile (Expo) env template.
# Copy to apps/mobile/.env. Only EXPO_PUBLIC_* values are readable on the client.
# NEVER put service-role / secret keys here — they would ship in the app bundle.
# Values are intentionally blank or local-only examples.
# When these are unset the app runs in DEMO MODE (fully browsable, no creds needed).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
