# ============================================================
# AI Reef Doctor — environment template.
# Copy to .env.local (web) and apps/mobile/.env (mobile).
# NEVER commit real values. All sk_/service-role keys are SERVER-ONLY.
# Nonblank values below are synthetic placeholders; replace locally.
# ============================================================

# --- AI (server-only) ---
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# --- Stripe (TEST mode for the whole build) ---
STRIPE_SECRET_KEY=YOUR_STRIPE_TEST_SECRET_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=YOUR_STRIPE_PUBLISHABLE_KEY

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
RESEND_API_KEY=YOUR_RESEND_API_KEY

# --- Mobile (Expo) reads EXPO_PUBLIC_* equivalents ---
# Put these in apps/mobile/.env :
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
