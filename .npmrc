# Keep pnpm's default isolated (symlinked) node_modules so the web app's React 19
# and the mobile app's React 18 stay separate — a fully hoisted layout would
# collapse them and break one of the two.
#
# Metro / @expo/metro-config do bare `require()`s for a handful of toolchain
# packages (e.g. hermes-parser) that they don't declare as dependencies and
# expect to find hoisted. Publicly hoist ONLY those build-time packages to the
# root node_modules so the iOS Metro bundle resolves, without altering app deps.
public-hoist-pattern[]=*hermes-parser*
public-hoist-pattern[]=*metro*
public-hoist-pattern[]=*babel*
public-hoist-pattern[]=*@react-native*
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*react-refresh*
